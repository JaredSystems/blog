---
import "../styles/global.css";
import VisitBeacon from "../components/VisitBeacon.astro";
import IndexContent from "../content/index.md"
import { getCollection } from "astro:content";

export const prerender = true;

const writings = (await getCollection("writings")).sort(
  (a, b) => b.data.article_date.getTime() - a.data.article_date.getTime(),
);

const dateFormatter = new Intl.DateTimeFormat("en-US", {
  dateStyle: "medium",
  timeZone: "UTC",
});
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="" />
		<meta name="generator" content={Astro.generator} />
		<title>jaredsystems</title>
	</head>
  <body class="home-page">
	<div class="img-wrapper">
<img class="pfp-img" src="/jared-black-bg.png" alt="jared" />
  <h2>jared</h2>
</div>


<nav class="nav">
  <div><a href="/" class="active">home</a></div>
    <div><a href="/books">books</a></div>
  <div><a href="/career">career</a></div>
  <div><a href="/papers">papers</a></div>

	<div><a href="https://github.com/JaredSystems">github</a></div>
		<!-- <div><a href="https://x.com/jaredsystems">x.com</a></div> -->
	
	</nav>

	<main class="main">

		<IndexContent/>

		<section class="section" aria-labelledby="writings-heading">
			<h2 id="writings-heading">Personal Writings</h2>
			<ul>
				{writings.map((writing) => (
					<li>
						<a href={`/writings/${writing.slug}`}>{writing.data.title}</a>{" "}
						<time datetime={writing.data.article_date.toISOString()}>
							— {dateFormatter.format(writing.data.article_date)}
						</time>
					</li>
				))}
			</ul>
		</section>
	</main>

	<VisitBeacon />
  </body>
</html>

# Configure this in Vercel's Production environment only. A measurement ID is
# public, but local and Preview environments should leave it unset.
PUBLIC_GA_MEASUREMENT_ID=

# Custom traffic: set these only in Vercel Production. Never enable locally or
# in Preview. Existing production KV_* values and ANALYTICS_SECRET are reused.
TRAFFIC_ENABLED=
ANALYTICS_SECRET=
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Optional FREE MaxMind GeoLite account; no paid GeoIP endpoint is used.
# Disabled by default even when credentials exist. Re-enable only deliberately.
# Server-only settings, never PUBLIC_* variables.
MAXMIND_ENABLED=false
MAXMIND_ACCOUNT_ID=
MAXMIND_LICENSE_KEY=
